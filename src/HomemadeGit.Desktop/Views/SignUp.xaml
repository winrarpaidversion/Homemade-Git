<UserControl x:Class="HomemadeGit.Desktop.Views.SignUp"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HomemadeGit.Desktop.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"  Background="#25292E"
             xmlns:vm="clr-namespace:HomemadeGit.Desktop.ViewModel"
             d:DataContext="{d:DesignInstance Type=vm:RegisterViewModel}">
    <Grid ColumnDefinitions="* ,*, *" RowDefinitions="*, auto,*">
        <Border Grid.Column="1" Grid.Row="1" BorderBrush="White" Background="Gray"  BorderThickness="3" CornerRadius="10">
            <StackPanel>
                <TextBlock Text="Регистрация" HorizontalAlignment="Center"></TextBlock>
                <TextBlock Text="введите новое имя" HorizontalAlignment="Left" Margin="10"></TextBlock>

                <TextBox Text="{Binding Login}" Margin="10"></TextBox>
                <TextBlock Text="введите новый пароль" HorizontalAlignment="Left" Margin="10"></TextBlock>
                <TextBox Text="{Binding Password}" Margin="10"  ></TextBox>
                <TextBlock Text="{Binding TitleError}" Foreground="Red"   Visibility="{Binding IsError}" IsEnabled="False" ></TextBlock>
                <Button Command="{Binding SignUpCommand}"  Width="120" Height="30" Margin="10"  Content="войти"></Button>
                <Button Command="{Binding GoToSignInCommand}" Width="120" Height="30"  Margin="10" Content="Авторизироваться"></Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
