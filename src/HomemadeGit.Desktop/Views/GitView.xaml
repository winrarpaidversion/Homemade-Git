<UserControl x:Class="HomemadeGit.Desktop.Views.GitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="Black"
             xmlns:views="clr-namespace:HomemadeGit.Desktop.Views"
             xmlns:vm="clr-namespace:HomemadeGit.Desktop.ViewModel"
             d:DataContext="{d:DesignInstance Type=vm:GitViewModel}">

    <Grid RowDefinitions="30, *" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="50" MaxWidth="250"></ColumnDefinition>
            <ColumnDefinition MinWidth="50" MaxWidth="320"></ColumnDefinition>
            <ColumnDefinition Width="auto"></ColumnDefinition>
        </Grid.ColumnDefinitions>
         <!--ПЕРВАЯ БОКОВАЯ ПАНЕЛЬ ДЛЯ КОММИТОВ И ПРОСМОТР РЕПОЗИТОРИЙ -->
        <Border Grid.Column="0" Grid.RowSpan="2" Background="#25292E" BorderBrush="AntiqueWhite" CornerRadius="20">

            <Grid RowDefinitions="*,*" >
                <StackPanel Orientation="Vertical" Grid.Column="0" Grid.Row="0">
                    <Menu>
                        <MenuItem Header="File" >
                            <MenuItem Header="New Repository" Command="{Binding NewRepositoryCommand}"/>
                        </MenuItem>
                    </Menu>
                    <ComboBox></ComboBox>
                    <Button  Content="Changes"  HorizontalAlignment="Stretch"></Button>
                    <Button  Content="History" Width="auto" HorizontalAlignment="Stretch" ></Button>
                    <ListBox ItemsSource="{Binding Pathtofile}" Height="145" Background="#1E2125">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
                <StackPanel  Orientation="Vertical" Grid.Row="1"  VerticalAlignment="Bottom">
                    <TextBox Text="{Binding Title}" Background="#1E2125" Foreground="White"></TextBox>
                    <TextBox Text="{Binding Description}" Height="120" Background="#1E2125" Foreground="White"></TextBox>
                    <Button Command="{Binding PushCommitCommand}"  Height="20" Background="#285496"></Button>
                </StackPanel>
            </Grid>
        </Border>
        <!--ВТОРАЯ ПАНЕЛЬ ДЛЯ СПИСОК ИЗ ПАПКИ И ПРОСМОТР РЕПОЗИТОРИЙ -->
        <Border Grid.Column="1" Grid.Row="1">
            <ListBox Background="Gray" 
             ItemsSource="{Binding Pathtofile}" 
             SelectedItem="{Binding SelectedItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,5,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="📄" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                <Setter Property="Text" Value="📁" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="White"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="5" VerticalAlignment="Stretch" Background="#1C1E21" Cursor="SizeWE"  />
        <!--ТРЕТЬЯ ПАНЕЛЬ ДЛЯ ПРОСМОТР КОДА ИЗ ПАПКИ-->
        <Grid Grid.Column="2" Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" >
            <ItemsControl  ItemsSource="{Binding CodeLine}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding  Number}" FontFamily="Consolas"
                             Foreground="White" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap"/>
                            <TextBox Grid.Column="1" Text="{Binding  Text, Mode=OneWay}" FontFamily="Consolas"
                              Foreground="White" 
                              Background="Transparent" 
                              BorderThickness="0" 
                              IsReadOnly="True" 
                              TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
