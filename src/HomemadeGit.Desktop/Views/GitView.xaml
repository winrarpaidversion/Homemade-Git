<UserControl x:Class="HomemadeGit.Desktop.Views.GitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="Black"
             xmlns:views="clr-namespace:HomemadeGit.Desktop.Views"
             xmlns:vm="clr-namespace:HomemadeGit.Desktop.ViewModel"
             d:DataContext="{d:DesignInstance Type=vm:GitViewModel}">

    <Grid RowDefinitions="30, *" >
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="50" MaxWidth="250"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Grid.RowSpan="2" Background="#25292E" BorderBrush="AntiqueWhite" CornerRadius="20">

            <Grid RowDefinitions="*,*" >
                <StackPanel Orientation="Vertical" Grid.Column="0" Grid.Row="0">
                    <Menu>
                        <MenuItem Header="File" >
                            <MenuItem Header="Check File" Command="{Binding NewRepositoryCommand}"/>
                        </MenuItem>


                    </Menu>
                    <ComboBox></ComboBox>
                    <Button  Content="Changes"  HorizontalAlignment="Stretch"></Button>
                    <Button  Content="History" Width="auto" HorizontalAlignment="Stretch" ></Button>

                </StackPanel>
                <StackPanel  Orientation="Vertical" Grid.Row="1"  VerticalAlignment="Bottom">
                    <TextBox Text="{Binding Title}" Background="#1E2125" Foreground="White"></TextBox>
                    <TextBox Text="{Binding Description}" Height="120" Background="#1E2125" Foreground="White"></TextBox>
                    <Button Command="{Binding PushCommitCommand}"  Height="20" Background="#285496"></Button>
                </StackPanel>
            </Grid>
        </Border>
        <GridSplitter Grid.Column="0" Grid.RowSpan="2" Width="5" VerticalAlignment="Stretch" Background="#1C1E21" Cursor="SizeWE"  />
        <Grid Grid.Column="2" Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" >
            <ItemsControl  ItemsSource="{Binding CodeLine}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding  Number}" FontFamily="Consolas"
                             Foreground="White" 
                             Background="Transparent" 
                             BorderThickness="0" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap"/>
                            <TextBox Grid.Column="1" Text="{Binding  Text, Mode=OneWay}" FontFamily="Consolas"
                              Foreground="White" 
                              Background="Transparent" 
                              BorderThickness="0" 
                              IsReadOnly="True" 
                              TextWrapping="Wrap"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
