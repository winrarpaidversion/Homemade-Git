<UserControl x:Class="HomemadeGit.Desktop.Views.GitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="1000"
             xmlns:vm="clr-namespace:HomemadeGit.Desktop.ViewModel"
             d:DataContext="{d:DesignInstance Type=vm:GitViewModel}">

    <Grid Background="#1E2125">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Строка статуса -->
        <Border Grid.Row="0" Grid.ColumnSpan="6" Background="#2C3136" Padding="5,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" >

                <TextBlock Text="{Binding StatusMessage}" Foreground="#8A8F98" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <ComboBox Name="Ветки"  Text="Ветка" ItemsSource="{Binding Branch}"  HorizontalAlignment="Center" >
                    <ComboBoxItem>
                        <DataTemplate>
                            <TextBlock FontWeight="Bold" Text="{Binding}"></TextBlock>
                        </DataTemplate>
                    </ComboBoxItem>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- ЛЕВАЯ ПАНЕЛЬ: Список репозиториев и создание -->
        <Border Grid.Row="1" Grid.Column="0" Background="#25292E">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Поиск -->
                <TextBox Grid.Row="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Background="#1E2125" Foreground="White" BorderBrush="#3A3F44" 
                         Margin="0,0,0,5" Padding="5">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchRepositoriesCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Row="1" Command="{Binding SearchRepositoriesCommand}" 
                        Content="🔍 Поиск" Background="#285496" Foreground="White" 
                        Margin="0,0,0,10" Height="30" BorderThickness="0"/>

                <!-- Список репозиториев -->
                <ListBox Grid.Row="2" ItemsSource="{Binding Repositories}" 
                         SelectedItem="{Binding SelectedRepository}"
                         Background="#1E2125" Foreground="White" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" Padding="5" Margin="0,2">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Foreground="White"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#8A8F98"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Кнопки управления репозиторием -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,5">
                    <Button Command="{Binding LoadRepositoryDetailsCommand}" 
                            Content="📂 Открыть" Background="#285496" Foreground="White" 
                            Height="25" Width="70" Margin="0,0,5,0" BorderThickness="0"/>
                    <Button Command="{Binding DeleteRepositoryCommand}" 
                            Content="🗑 Удалить" Background="#963528" Foreground="White" 
                            Height="25" Width="70" BorderThickness="0"/>
                </StackPanel>

                <Separator Grid.Row="4" Background="#3A3F44" Margin="0,10"/>

                <!-- Создание репозитория -->
                <TextBlock Grid.Row="5" Text="✨ Создать репозиторий" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>

                <CheckBox Grid.Row="6" Content="Публичный" Foreground="Gray" 
                          IsChecked="{Binding IsPublic}" Margin="0,0,0,5"/>

                <TextBox Grid.Row="7" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                         Background="#1E2125" Foreground="White" Margin="0,0,0,5" 
                         TextWrapping="Wrap" Height="30" BorderBrush="#3A3F44"/>

                <TextBox Grid.Row="8" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                         Background="#1E2125" Foreground="White" TextWrapping="Wrap" 
                         Height="60" Margin="0,0,0,5" BorderBrush="#3A3F44"/>

                <Button Grid.Row="9" Command="{Binding CreateRepositoryCommand}" 
                        Content="➕ Создать" Height="30" Background="#285496" Foreground="White" BorderThickness="0"/>
            </Grid>
        </Border>
        <!--ИСТОРИЯ КОММИТОВ-->
        <Border Grid.Column="1" Grid.Row="1">
            <Grid RowDefinitions="auto,*">
                <StackPanel Grid.Row="0" Orientation="Horizontal" >
                    <TextBlock Text="Коммиты" Foreground="White" FontWeight="Bold" HorizontalAlignment="Left"/>
                    
                    <Button Command="{Binding CloneRepositoryCommand}" Content="Клонировать"
                            Background="#285496"
                            Foreground="White"
                            Margin="0,5,0,0"
                            Height="25"
                            BorderThickness="0"/>

                    <Button Command="{Binding ResetToCommitCommand}" Content="Откатиться к коммиту" 
                            Background="#963528" 
                            Foreground="White" 
                            Margin="0,5,0,5" 
                            Height="25"
                            BorderThickness="0"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Historycommits}" Background="#1E2125" Foreground="White" Grid.Row="1"  SelectedItem="{Binding SelectedCommit}" >
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <TextBlock Text="{Binding  AuthorLogin}" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding  Title}" Foreground="Gray"/>
                                <TextBlock Text="{Binding  Description}" Foreground="Gray"/>
                     
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <!--ПАНЕЛЬ КОММИТОВ -->
        <Border Grid.Column="2" Grid.Row="1">
            <Grid RowDefinitions="*,*">
                <ScrollViewer  HorizontalScrollBarVisibility="Auto">
                <ListBox ItemsSource="{Binding Commits}" Background="#1E2125" Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="5">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="Репозиторий: " Foreground="#6A6F78" FontSize="12"/>
                                    <TextBlock Text="{Binding DataContext.SelectedRepository.Name, RelativeSource={RelativeSource AncestorType=ListBox}}" Foreground="#4A90E2" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>

                                <TextBlock Text="{Binding AuthorLogin}" Foreground="#859900" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Hash}" Foreground="#6A6F78" FontSize="11"/>

                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Margin="0,3"/>
                                <TextBlock Text="{Binding Description}" Foreground="#A0A0A0" TextWrapping="Wrap" Margin="0,0,0,5"/>

                                <TextBlock Text="Измененные файлы:" Foreground="#6A6F78" FontSize="11" Margin="0,3,0,0"/>
                                <ItemsControl ItemsSource="{Binding Files}" Margin="10,0,0,5">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Path}" Foreground="#D7BA7D" Margin="0,1"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Foreground="#6A6F78" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Margin="10">
                    <TextBlock Text="Title" Foreground="White"/>
                    <TextBox Text="{Binding TitleCommit}" Margin="0,5"/>
                    <TextBlock Text="Description" Foreground="White"/>
                    <TextBox Text="{Binding DescriptionCommit}" Margin="0,5"/>
                    <Button Command="{Binding NewCommitCommand}" Content="Закоммитить" Background="#285496" Foreground="White" Padding="0,5"/>
                </StackPanel>
            </Grid>
        </Border>


        <!-- СРЕДНЯЯ ПАНЕЛЬ: Содержимое репозитория -->
        <Border Grid.Row="1" Grid.Column="4" Background="#25292E">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,5">
                    <TextBlock Text="📁 Файлы" Foreground="White" FontWeight="Bold"/>
                    <Button Command="{Binding BrowseFolderCommand}" 
                            Content="📂 Выбрать папку" Background="#285496" Foreground="White" 
                            Height="20" Margin="10,0,0,0" BorderThickness="0" FontSize="10"/>
                </StackPanel>

                <ListBox Grid.Row="1" Background="#1E2125" BorderThickness="0"
                         ItemsSource="{Binding PathToFile}" 
                         SelectedItem="{Binding SelectedItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2">
                                <TextBlock VerticalAlignment="Center" Margin="0,0,5,0" Foreground="White">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="📄"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                    <Setter Property="Text" Value="📁"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="White" FontSize="13"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>


        <!-- ПРАВАЯ ПАНЕЛЬ: Просмотр кода -->
        <Border Grid.Row="1" Grid.Column="5" Background="#1E2125">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📝 Код" Foreground="White" FontWeight="Bold" Margin="0,0,0,5"/>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" 
                              Background="#1A1C20">
                    <ItemsControl ItemsSource="{Binding CodeLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#2A2D33">
                                        <TextBlock Text="{Binding Number}" FontFamily="Consolas"
                                                   Foreground="#6A6F78" 
                                                   HorizontalAlignment="Center" FontSize="13"/>
                                    </Border>
                                    <TextBox Grid.Column="1" Text="{Binding Text, Mode=OneWay}" 
                                             FontFamily="Consolas" Foreground="#D4D4D4" 
                                             Background="Transparent" BorderThickness="0" 
                                             IsReadOnly="True" TextWrapping="NoWrap" FontSize="13"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>