<UserControl x:Class="HomemadeGit.Desktop.Views.GitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Background="Black"
             xmlns:views="clr-namespace:HomemadeGit.Desktop.Views"
            xmlns:vm="clr-namespace:HomemadeGit.Desktop.ViewModel"
                d:DataContext="{d:DesignInstance Type=vm:GitViewModel}">

    <Grid ColumnDefinitions="200,*" RowDefinitions="*, *" ShowGridLines="True">
        <Border Grid.Column="0" Grid.RowSpan="2" Background="Gray" BorderBrush="AntiqueWhite" CornerRadius="20">
            <Grid RowDefinitions="*,*" ShowGridLines="True">
                <StackPanel  Orientation="Vertical" Grid.Row="1"  VerticalAlignment="Bottom">
                    <TextBox ></TextBox>
                    <TextBox Height="120"></TextBox>
                    <Button Height="20"></Button>
                </StackPanel>
            </Grid>
        </Border>
        <GridSplitter Grid.Column="0" Grid.RowSpan="2" Width="5" VerticalAlignment="Stretch" Background="#CCCCCC" Cursor="SizeWE"  />

    </Grid>
</UserControl>
